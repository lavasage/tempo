{
  "description": "Tempo 教练端小程序",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tools" },
      { "type": "folder", "value": "tests" },
      { "type": "folder", "value": "node_modules" }
    ]
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "newFeature": true,
    "nodeModules": false,
    "checkSiteMap": false,
    "coverView": true,
    "showShadowRootInWxmlPanel": true,
    "useCompilerPlugins": false
  },
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "appid": "touristappid",
  "projectname": "tempo",
  "miniprogramRoot": "./",
  "condition": {}
}
